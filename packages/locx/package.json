{
  "name": "@locx/react-native",
  "version": "0.1.0",
  "description": "Open React Native background location and durable delivery engine",
  "license": "MIT",
  "author": "Sundan Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sundanpatyad/locx-geolocation.git",
    "directory": "packages/locx"
  },
  "bugs": {
    "url": "https://github.com/Sundanpatyad/locx-geolocation/issues"
  },
  "homepage": "https://github.com/Sundanpatyad/locx-geolocation#readme",
  "keywords": [
    "react-native",
    "expo",
    "android",
    "ios",
    "background",
    "geolocation",
    "location-tracking"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "android",
    "ios",
    "src",
    "lib",
    "locx.podspec",
    "app.plugin.js",
    "react-native.config.js",
    "!android/build",
    "!android/src/test",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=8",
    "react": "*",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^10.1.2",
    "@react-native/babel-preset": "^0.83.1",
    "@react-native/codegen": "^0.83.1",
    "@react-native/eslint-config": "^0.83.1",
    "@react-native/typescript-config": "^0.83.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.0",
    "react-native": "0.83.1",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.8.3"
  },
  "codegenConfig": {
    "name": "LocXSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.locx"
    },
    "ios": {
      "modules": {
        "LocX": {
          "requiresMainQueueSetup": true
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
