{
  "name": "locx-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build -w react-native-locx",
    "test": "npm run test -w react-native-locx",
    "typecheck": "npm run typecheck -w react-native-locx",
    "mock-server": "npm run start -w @locx/mock-server"
  },
  "engines": {
    "node": ">=20"
  }
}
